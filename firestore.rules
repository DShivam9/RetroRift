rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for validation
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isValidString(str, maxLength) {
      return str is string && str.size() <= maxLength;
    }

    // ─── Users: strict validation for the main user document ───
    match /users/{userId} {
      // Read allowed only for the owner
      allow read: if isOwner(userId);
      
      // Write allowed for owner with strict schema validation
      allow write: if isOwner(userId)
                   // Prevent excessively large documents
                   && request.resource.data.size() < 20
                   // Ensure required/expected fields have correct types and lengths
                   && (!('displayName' in request.resource.data) || isValidString(request.resource.data.displayName, 50))
                   && (!('photoURL' in request.resource.data) || isValidString(request.resource.data.photoURL, 500))
                   && (!('theme' in request.resource.data) || isValidString(request.resource.data.theme, 30))
                   && (!('bio' in request.resource.data) || isValidString(request.resource.data.bio, 500));

      // Explicit subcollection: data (saves, xp)
      match /data/{docId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && request.resource.data.size() < 100;
      }

      // Explicit subcollection: gameStates metadata
      match /gameStates/{gameId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && request.resource.data.size() < 100;
      }
      
      // Explicit subcollection: gameStates binaries (hard limit to 1MB)
      match /gameStates/{gameId}/binaries/{slotId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) 
                     && request.resource.data.size() <= 5
                     && (!('data' in request.resource.data) || (request.resource.data.data is bytes && request.resource.data.data.size() < 1000000));
      }
    }

    // ─── Deny everything else by default ───
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
