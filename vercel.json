{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self' https: data: blob: 'unsafe-inline' 'unsafe-eval';"
        }
      ]
    },
    {
      "source": "/(player|play)(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "credentialless"
        }
      ]
    }
  ],
  "redirects": [],
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://retrorift-57c7e.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/site.xml",
      "destination": "/sitemap.xml"
    },
    { "source": "/library", "destination": "/index.html" },
    { "source": "/favorites", "destination": "/index.html" },
    { "source": "/profile", "destination": "/index.html" },
    { "source": "/player", "destination": "/index.html" },
    { "source": "/login", "destination": "/index.html" },
    { "source": "/feedback", "destination": "/index.html" },
    { "source": "/privacy-policy", "destination": "/index.html" },
    { "source": "/terms-of-service", "destination": "/index.html" },
    { "source": "/play/:path*", "destination": "/index.html" }
  ]
}
